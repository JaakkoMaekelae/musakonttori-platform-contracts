{
  "name": "@musakonttori/hq-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Identical HQ integration layer for every Musakonttori service",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@musakonttori/platform-contracts": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
